---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="contenedor py-32 text-center">
    <p class="antetitulo">Error 404</p>
    <h1 class="mt-4 text-5xl">Esta receta no está en el libro</h1>
    <p class="mx-auto mt-5 max-w-md text-chocolate-700">La página que buscás no existe o se mudó de lugar.</p>
    <a href="/" class="boton-primario mt-10">Volver al inicio</a>
  </section>
</Base>
